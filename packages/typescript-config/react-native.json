{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "TezUsta React Native / Expo app",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,

    "// Metro resolves these": "Expo's generated tsconfig supplies paths + expo-env.d.ts."
  }
}
