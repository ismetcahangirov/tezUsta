// Module resolution is Metro's. The app supplies its own ambient types
// (expo/types, nativewind/types) rather than relying on a generated tsconfig.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "TezUsta React Native / Expo app",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  }
}
