{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "TezUsta Node service (NestJS)",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "outDir": "dist",
    "rootDir": "src",

    // Nest's DI container reads decorator metadata at runtime.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    // `verbatimModuleSyntax` conflicts with `emitDecoratorMetadata`: Nest needs
    // the type import to survive into the emitted JavaScript.
    "verbatimModuleSyntax": false
  }
}
