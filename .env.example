# ---------------------------------------------------------------------------
# TezUsta — environment variable template
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Every variable here MUST be validated at process start (see
# docs/engineering/security.md § Environment validation).
#
# Values below are placeholders ONLY. They are not real credentials.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0
# Comma-separated list of allowed origins for the admin web app.
CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL + PostGIS) -----------------------------------------
# ADR-0003: PostGIS is required for nearby-master radius queries.
DATABASE_URL=postgresql://tezusta:tezusta@localhost:15432/tezusta
DATABASE_POOL_MAX=10

# --- Redis (cache, presence, BullMQ queues) ----------------------------------
REDIS_URL=redis://localhost:6379
# Namespace for every Redis key the API writes itself — presence
# (`<prefix>:presence:master:<id>`) and the catalogue cache. Redis is shared:
# two checkouts, or a CI job and a developer's `pnpm test`, point at one
# container, and a keyspace whose name is a constant lets one run read and
# delete another's. 1-32 characters of a-z, A-Z, 0-9, _ or - .
#
# Separate from QUEUE_PREFIX deliberately. That one names keys BullMQ owns, and
# renaming it strands every delayed job in flight; everything under this one is
# a cache of something authoritative elsewhere, so renaming it costs one cold
# interval — presence is back within a heartbeat and the catalogue is one miss
# from correct. Changing either is a cold start for its own keyspace, so make
# it deliberately rather than as a side effect.
REDIS_KEY_PREFIX=tezusta

# --- Authentication ----------------------------------------------------------
# Generate with: openssl rand -base64 48
# These MUST be different values, and MUST be rotated per environment.
JWT_ACCESS_SECRET=CHANGE_ME_generate_a_48_byte_random_value
JWT_REFRESH_SECRET=CHANGE_ME_generate_a_different_48_byte_random_value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Seconds after a refresh token is spent in which presenting it AGAIN is read
# as the same client retrying a lost response rather than as a stolen token
# being replayed. Without it, one dropped response on a flaky mobile network
# signs the user out of every device they own. 0 disables the retry path.
REFRESH_REUSE_GRACE_SECONDS=10

# --- Authentication rate limiting (ADR-0008) ---------------------------------
# State lives in Redis, never in process memory: N instances must enforce ONE
# limit, and a deploy must not reset it.
#
# RATE_LIMIT_KEY_SECRET is the HMAC pepper every phone number and IP is hashed
# under before it becomes a Redis key. Without it the key space would be a
# reversible list of everyone who tried to sign in — an Azerbaijani mobile
# number is under 10^9 candidates, which is seconds of unsalted SHA-256.
# Generate with: openssl rand -base64 48
# It MUST differ from both JWT secrets — a pepper fed attacker-chosen input is
# not a token-signing key, and a shared secret is one nobody can rotate.
RATE_LIMIT_KEY_SECRET=CHANGE_ME_generate_another_48_byte_random_value
# Sign-in on the consumer path IS OTP verify (authentication.md § Rate
# limiting); the same policy covers the admin form from EPIC 13.
SIGNIN_RATE_LIMIT_PER_IDENTIFIER_HOUR=10
SIGNIN_RATE_LIMIT_PER_IP_HOUR=30
# Refresh is limited per session. A healthy client rotates ~4 times an hour at
# JWT_ACCESS_TTL=15m; 60 leaves room for retries and still catches a replay.
REFRESH_RATE_LIMIT_PER_SESSION_HOUR=60
REFRESH_RATE_LIMIT_PER_IP_HOUR=120
# Backoff: a request made while ALREADY over a limit pushes that window's
# reset out by one more window, capped at this multiple. 1 disables backoff.
AUTH_RATE_LIMIT_BACKOFF_MULTIPLIER=4

# --- Price-range rate limiting (issue #84) -----------------------------------
# GET /services/:id/price-range is public and computed live on every call
# (ADR-0013), so it carries none of the catalogue's cache-first mitigation
# (ADR-0020). This budget is what stands between it and master_services.
PRICE_RANGE_RATE_LIMIT_PER_USER_HOUR=120
PRICE_RANGE_RATE_LIMIT_PER_IP_HOUR=300

# --- Admin authentication (ADR-0014) -----------------------------------------
# The admin path has its own account store (`admin_users`), its own token
# family and its own signing key. A consumer OTP token cannot reach an admin
# endpoint and an admin token cannot reach a consumer one: different audience,
# different key.
#
# SECRET, and the most valuable one here — it signs tokens that suspend masters
# and read personal data across the platform. It MUST differ from every other
# signing secret, and the API refuses to boot if it does not.
JWT_ADMIN_ACCESS_SECRET=CHANGE_ME_generate_a_48_byte_random_value
ADMIN_ACCESS_TTL=15m
# 8 hours, against the consumer path's 30 days. An admin credential is worth
# far more, so it is re-proved far more often.
ADMIN_SESSION_TTL=8h
# Inactivity after which an admin session stops working. The consumer path has
# no equivalent: an admin console left open on an unattended laptop is a
# different risk from a phone in a pocket.
ADMIN_SESSION_IDLE_TIMEOUT=30m

# --- Object storage (S3-compatible — ADR-0005, ADR-0024) ---------------------
# The provider is Cloudflare R2 (ADR-0024). Nothing here is R2-specific: the
# client speaks the S3 API only, so the same values point at S3 or MinIO.
#
# `stub` keeps uploaded objects in memory so the whole verification flow runs
# with no storage account. It REFUSES to start under NODE_ENV=production.
STORAGE_PROVIDER=stub
S3_ENDPOINT=
# R2 ignores the region and expects the literal `auto`.
S3_REGION=auto
S3_BUCKET=tezusta-uploads
S3_ACCESS_KEY_ID=
# SECRET. Never prefix this with EXPO_PUBLIC_ — it is write access to the
# bucket holding every master's identity documents.
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
# Upload-URL lifetime. ADR-0005 caps it at 5 minutes: the window is the whole
# exposure of a leaked URL.
UPLOAD_PRESIGN_TTL_SECONDS=300
# Read-URL lifetime, shorter — nothing waits on a read.
UPLOAD_DOWNLOAD_TTL_SECONDS=120
# Hard cap on one verification document, in bytes. 5 MiB holds a phone
# photograph of an ID card and stops well short of anything that is not one.
# Enforced at CONFIRM against the real object, not in the signature: R2 does
# not implement the S3 POST form-policy that would bind a range (ADR-0024).
VERIFICATION_DOCUMENT_MAX_BYTES=5242880
# Presigned upload URLs one master may mint per hour. Every one of them is
# permission to write bytes into a bucket somebody pays for.
UPLOAD_PRESIGN_RATE_LIMIT_PER_USER_HOUR=30
UPLOAD_PRESIGN_RATE_LIMIT_PER_IP_HOUR=60
# Hard cap on one order problem photo, in bytes (issue #83). A separate knob
# from VERIFICATION_DOCUMENT_MAX_BYTES — same default and bounds today, but a
# problem photo and an identity document are different product surfaces.
# Enforced at CONFIRM against the real object, same as above.
ORDER_PHOTO_MAX_BYTES=5242880

# --- Orders (EPIC 6) ---------------------------------------------------------
# Orders one customer may create per hour. What this bounds is dispatch, not a
# bill: every created order broadcasts to nearby masters (ADR-0009), so a loop
# here rings real phones belonging to real people.
ORDER_CREATE_RATE_LIMIT_PER_USER_HOUR=20
ORDER_CREATE_RATE_LIMIT_PER_IP_HOUR=40
# Status transitions one master may perform per hour (issue #134). Bounds a
# client stuck in a retry loop writing rows into an append-only trail — not a
# bill and not a broadcast, so deliberately loose: an order takes four
# transitions, making 120 about thirty finished jobs in an hour.
ORDER_TRANSITION_RATE_LIMIT_PER_USER_HOUR=120
ORDER_TRANSITION_RATE_LIMIT_PER_IP_HOUR=240
# The most problem photos a customer may attach to one order (issue #83).
# Enforced atomically against orders.photo_count, not read-then-write.
MAX_ORDER_PHOTOS=6

# --- Maps & geocoding (Google Maps Platform — ADR-0004) ----------------------
# GOOGLE_MAPS_SERVER_API_KEY is the BILLABLE server key: it carries billing power
# and must NEVER be given the EXPO_PUBLIC_ prefix. IP-restricted, minimum scope.
#
# The two mobile keys are the one documented exception to the EXPO_PUBLIC_ rule
# below (see docs/engineering/security.md § EXPO_PUBLIC_ and what counts as a
# secret). They ship in the bundle because the client cannot render a map
# without them, and they are protected by RESTRICTION, not secrecy: each is
# locked to the bundle id / package name and scoped to the Maps SDK, so a copied
# key is refused when it arrives from another application. Configure those
# restrictions in the Google Cloud console before shipping, or the exception
# does not hold.
#
# Enable: Maps SDK (Android + iOS), Geocoding API, Distance Matrix API.
#
# MAPS_PROVIDER=stub is the default and needs no key: it derives coordinates
# from the address text so the app and its tests run offline and free. It
# refuses to start under NODE_ENV=production, so it cannot ship by accident.
MAPS_PROVIDER=stub
GOOGLE_MAPS_SERVER_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=
#
# Geocode cache TTL, in days. The cache is the largest lever on the Maps bill —
# the same Baku addresses recur constantly — but the ceiling is not ours to
# choose: Google's Maps Service Specific Terms §6.3.1 allow caching latitude and
# longitude "for up to 30 consecutive calendar days, after which Customer must
# delete the cached latitude and longitude values". Anything above 30 is
# rejected at boot rather than silently breaching the licence.
GEOCODE_CACHE_TTL_DAYS=30
# Response language and the enforced country filter (ISO 3166-1 alpha-2).
GEOCODE_LANGUAGE=az
GEOCODE_COUNTRY=AZ
# A geocode sits on the path of a customer saving an address; past a few
# seconds the honest answer is "type it in yourself".
GEOCODE_TIMEOUT_MS=4000
# Every call that reaches the provider costs money, so the endpoints are
# budgeted per user and per IP, like OTP sends.
GEOCODE_RATE_LIMIT_PER_USER_HOUR=60
GEOCODE_RATE_LIMIT_PER_IP_HOUR=120

# --- SMS / OTP (sign-in — ADR-0008) ------------------------------------------
# For customers and masters, sign-in is phone + SMS OTP and it is the only
# sign-in path. Without a working provider nobody can enter the app.
# Admin accounts are separate: email + password + TOTP on apps/admin, and they
# never touch these variables (ADR-0014).
# Provider is still undecided; "stub" logs the code locally and must NEVER be
# used outside development.
SMS_PROVIDER=stub
SMS_API_KEY=
SMS_SENDER_ID=
# OTP_CODE_PEPPER is the HMAC key every code is hashed under before it is
# written to `otp_challenges`. A six-digit code is ~20 bits, so an UNKEYED hash
# of one is inverted by trying all 10^6 candidates — a leaked dump would be a
# list of live codes. Keyed, the dump is worthless without this value.
# Generate with: openssl rand -base64 48
# It MUST differ from the JWT secrets and RATE_LIMIT_KEY_SECRET: this is the
# one secret that has to be rotatable the day a database dump is suspected,
# and rotating a shared secret signs every user out instead.
OTP_CODE_PEPPER=CHANGE_ME_generate_yet_another_48_byte_random_value
# OTP policy. These are security controls, not tuning knobs — see ADR-0008.
# Range-checked, not merely positive: 6 digits is the ADR's floor, and the TTL
# is capped at the ADR's five minutes, so a typo fails the deploy instead of
# widening the brute-force window.
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_PER_PHONE_HOUR=5
OTP_RATE_LIMIT_PER_IP_HOUR=20

# --- Master presence (issue #40) ---------------------------------------------
# "Online" is two facts: intent in Postgres (the master flipped the switch) and
# liveness in Redis with a TTL (the app is actually reachable). Matching needs
# both — a boolean alone cannot expire, so a phone that died in a tunnel would
# stay available forever.
#
# The TTL is three heartbeats, so two beats can be lost to a tunnel or a bad
# minute of signal before a working master is dropped. The API refuses to boot
# if the TTL is less than twice the heartbeat.
PRESENCE_TTL_SECONDS=180
# Aligned with the 60-120s location-reporting interval for an online master
# with no order, so the heartbeat rides alongside a report the app was going to
# make anyway rather than adding a wake-up of its own to somebody's battery.
PRESENCE_HEARTBEAT_SECONDS=60

# --- Master location reporting (issue #98) -----------------------------------
# How long one master's position trail is kept. A RETENTION rule, not a tuning
# knob: master_locations is the most sensitive table in the schema. Bounded from
# two directions — each report deletes that master's older rows in the same
# transaction that writes the new one, and the `maintenance` sweep ages out the
# trail of a master who has STOPPED reporting, for whom no write is ever coming
# (#105). Lower is more private; a reporting master's latest position is always
# inside the window, so lowering this cannot break dispatch.
MASTER_LOCATION_TRAIL_MINUTES=60
# Position reports one master may send per hour. Sized from the location update
# budget (docs/architecture/realtime-architecture.md): the fastest documented
# state is one report every 10-15s while travelling, i.e. 240-360 an hour.
# The server, not the app, is the authority on the interval — this is where.
MASTER_LOCATION_RATE_LIMIT_PER_USER_HOUR=600
# Loose on purpose: masters are on mobile networks, where a carrier NAT hides an
# unknown number of them behind one address. This is a ceiling against a single
# abusive host; the per-master budget above is the actual control.
MASTER_LOCATION_RATE_LIMIT_PER_IP_HOUR=3000

# --- Master offer responses (issue #101) -------------------------------------
# Accepts and declines one master may send per hour. On ADR-0009's
# first-accept-wins model an unthrottled accept loop is how one scripted client
# takes every job in the city from the masters answering by hand. 300/hour is
# one response every twelve seconds sustained — past what a human does, short
# of what a loop does.
MASTER_OFFER_RESPONSE_RATE_LIMIT_PER_USER_HOUR=300
# Loose for MASTER_LOCATION_RATE_LIMIT_PER_IP_HOUR's reason, and the same
# population: masters behind one carrier NAT.
MASTER_OFFER_RESPONSE_RATE_LIMIT_PER_IP_HOUR=3000

# Feed reads (GET /masters/me/offers) one master may make per hour. Until
# EPIC 9's realtime channel lands, a master's app discovers offers by polling.
# The number assumes a FIVE-SECOND poll — 720/hour — plus headroom for
# pull-to-refresh, app restarts and retries. Bring it down when push replaces
# polling.
MASTER_OFFER_FEED_RATE_LIMIT_PER_USER_HOUR=900
# Looser still than the response policy's per-IP half: the same masters behind
# the same carrier NATs, each of them polling.
MASTER_OFFER_FEED_RATE_LIMIT_PER_IP_HOUR=9000

# --- Device registry (EPIC 10, issue #140) -----------------------------------
# Device registrations one account may make per hour. This bounds the size of
# the devices table, not a bill: every accepted row is an address the
# notification worker fans out to and issue #142 chases a receipt for, so a
# loop registering fresh tokens is paid for on every later send and delivers to
# nobody. A real client registers on sign-in, on token rotation and on launch —
# single digits an hour even for somebody reinstalling repeatedly.
DEVICE_REGISTRATION_RATE_LIMIT_PER_USER_HOUR=60
# Loose for MASTER_LOCATION_RATE_LIMIT_PER_IP_HOUR's reason: the same
# population behind the same carrier NATs, and a shared exit must not lock out
# a whole building.
DEVICE_REGISTRATION_RATE_LIMIT_PER_IP_HOUR=600

# --- Dispatch (ADR-0009) -----------------------------------------------------
# Bolt-style parallel broadcast, first accept wins. Starting hypotheses —
# EPIC 7 must replace them with measured values.
DISPATCH_INITIAL_RADIUS_M=3000
DISPATCH_MAX_RADIUS_M=10000
DISPATCH_RADIUS_STEP_SECONDS=30
DISPATCH_TOTAL_TIMEOUT_SECONDS=180
DISPATCH_MAX_MASTERS_PER_BROADCAST=20
# How old a master's newest position may be before dispatch treats them as
# MISSING rather than as "in range at their last known point" (ADR-0026).
#
# NOT the presence TTL, and never set from it: a position report refreshes
# presence, but a heartbeat writes no position, so a master parked 800m away and
# beating every 60s stays live in Redis with a position that stops being
# refreshed. Bounding one by the other deleted exactly that master from every
# broadcast. What this bounds is a position left over from a PREVIOUS session —
# app killed at A, master drives to B, reopens, first report not yet landed.
#
# Derived, not chosen: the location budget guarantees a report at least once per
# interval while online regardless of movement (120s at the slow end), plus one
# missed report, plus 60s for a late fix and clock skew. 120+120+60 = 300.
DISPATCH_MAX_POSITION_AGE_SECONDS=300
# Re-dispatch: how many times one order may go back out after an assigned
# master cancels, before it becomes NO_MASTER_FOUND (ADR-0015).
MAX_ORDER_REDISPATCHES=2
# How often the orphaned-search reconciler runs, in seconds. 0 disables it
# entirely — nothing is upserted and nothing reconciles. Max 3600 (an hour).
#
# ADR-0025 accepts that a lost Redis means lost DEADLINES: an order whose
# give-up job vanished — a flush, an eviction, a restart without persistence, a
# QUEUE_PREFIX changed between deploys — sits in SEARCHING forever, which the
# customer sees as a spinner that never resolves. This is what notices. It runs
# on the `maintenance` queue and does nothing at all in a healthy system.
#
# Seconds rather than minutes because of what it bounds: the wait a customer
# actually experiences is DISPATCH_TOTAL_TIMEOUT_SECONDS + the grace below +
# worst-case one of these intervals. On the shipped numbers, five minutes.
DISPATCH_RECONCILE_INTERVAL_SECONDS=60
# How long past its own deadline an order must have been SEARCHING before the
# reconciler will look at it. Slack for the ordinary lateness a queue is
# allowed — a busy worker, a tick still working through its retry backoff — so
# the reconciler never races the give-up job it exists to replace. Too small
# and it ends searches the engine was about to finish properly.
DISPATCH_RECONCILE_GRACE_SECONDS=60

# --- Deferred work / BullMQ (ADR-0025) ---------------------------------------
# The mechanism time-driven work runs on: a job enqueued with a delay, executed
# later by a worker. Dispatch is the first consumer — widen the radius in 30s,
# give up at 3 minutes — but nothing here is a dispatch parameter.
#
# Namespace for every BullMQ key (`<prefix>:<queue>:<...>`). Redis is shared:
# two environments, or a CI job and a developer's `pnpm test`, pointing at one
# container with the same prefix means one run's worker consumes the other's
# jobs. 1-32 characters of a-z, A-Z, 0-9, _ or - .
QUEUE_PREFIX=tezusta
# `in-process` — the API replica consumes its own queue (what ships today).
# `off`        — the replica produces jobs and consumes none. Set this on the
#                API when a separate worker deployment exists; ADR-0025 records
#                why there is not one yet.
QUEUE_WORKER_MODE=in-process
# Jobs one worker runs at once. Keep it well under DATABASE_POOL_MAX.
QUEUE_WORKER_CONCURRENCY=5
# Total attempts per job, retries included; 1 disables retrying. The nth retry
# waits QUEUE_JOB_BACKOFF_MS * 2^(n-1).
QUEUE_JOB_ATTEMPTS=3
QUEUE_JOB_BACKOFF_MS=5000

# --- Maintenance sweeps ------------------------------------------------------
# Retention jobs on the `maintenance` queue: expired refresh tokens and dead
# sessions, expired geocode cache rows, confirmed-but-never-attached order
# photos, verification documents presigned and never confirmed, and the position
# trails of masters who have stopped reporting. They run on a BullMQ job
# scheduler, so every replica may register them and exactly one worker in the
# fleet runs each iteration.
#
# How often each sweep runs, in minutes. 0 disables scheduling entirely —
# nothing is upserted and nothing sweeps. Max 1440 (a day).
MAINTENANCE_SWEEP_INTERVAL_MINUTES=60
# The most rows one iteration deletes, per table. This is the number that
# decides how long a single statement holds locks on a table a request path is
# using; a sweep that does not finish simply finishes next interval.
MAINTENANCE_BATCH_SIZE=1000
# How long a spent or expired refresh token and its session are kept after
# they stop being usable. MUST be at least JWT_REFRESH_TTL: below that the
# sweep deletes live credentials, and the spent rows that make refresh-token
# reuse detection possible are gone before the family expires. The default
# leaves a fortnight past the shipped 30-day family to investigate an incident.
AUTH_RETENTION_DAYS=45
# The same, for a session revoked because refresh-token reuse was DETECTED.
# Longer, because those rows are the only record that a theft signal fired and
# an investigation may start long after the event; bounded, because a signal
# nobody will ever read again is session metadata kept for no reason. Must be
# at least AUTH_RETENTION_DAYS. A year, and the row is kept whole for it, then
# deleted — decided in docs/decisions/ADR-0027.
AUTH_INCIDENT_RETENTION_DAYS=365
# How long a confirmed order photo that was never attached to an order is kept
# before its storage object and its row are deleted.
ORDER_PHOTO_ABANDONED_AFTER_HOURS=24
# How long a verification document whose upload URL was minted and never
# confirmed is kept before its storage object and its row are deleted.
# Measured from the MASTER'S LAST DOCUMENT ACTIVITY, not from the row's own
# age: somebody part-way through gathering the three documents ADR-0023 wants
# must not lose the first one while they are still finding the third. A
# document that reached review — waiting for an admin, accepted or rejected —
# is never swept, at any age.
#
# A separate knob from ORDER_PHOTO_ABANDONED_AFTER_HOURS, and much longer: an
# order photo is a picture of a leaking tap taken minutes before the request,
# and this is an identity document gathered over days. Max 2160 (90 days) —
# past that it stops being a retention rule and becomes "keep identity
# documents indefinitely", which is the thing the sweep exists to stop.
MASTER_DOCUMENT_ABANDONED_AFTER_HOURS=168

# --- Order lifecycle and commission (ADR-0013, ADR-0015, ADR-0007) -----------
# A master above this cash-commission debt cannot accept new work. Reads 0
# until EPIC 12 populates the column, so the eligibility term ships in EPIC 7.
# Minor units: 5000 = 50.00 AZN.
MAX_COMMISSION_DEBT_MINOR=5000
# How long after an order is paid a customer may still open a dispute.
DISPUTE_WINDOW_HOURS=72

# --- Push notifications ------------------------------------------------------
EXPO_ACCESS_TOKEN=

# --- Mobile app (EXPO_PUBLIC_* is embedded in the app bundle) ----------------
# WARNING: anything prefixed EXPO_PUBLIC_ ships to the client and is readable by
# any user who unzips the APK. Treat it as published.
#
# A value is a SECRET if it grants server authority or billing power — a signing
# key, a database URL, an SMS or storage credential, the billable Maps server
# key. Those never carry this prefix. The only documented exception is a
# platform-restricted client map key above, where the restriction rather than
# the secrecy is the control.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_WS_URL=ws://localhost:3000

# --- Observability -----------------------------------------------------------
# The least severe line the process writes: debug | info | warn | error.
# A THRESHOLD, not a set — each value also enables everything above it, and
# `fatal` is always written.
#
# Applied at startup (issue #129). The default depends on NODE_ENV rather than
# on this file: `production` gets `info`, every other environment `debug`,
# which is what the process printed before the variable did anything. The
# value below is the development default written out.
#
# `error` is REFUSED under NODE_ENV=production, and the refusal is a security
# control rather than an opinion about volume: every expected client error and
# every rate-limit trigger is logged at `warn`, and
# docs/engineering/security.md § Logging requires those triggers to stay
# logged. Use `warn` to quiet a production log.
#
# Structured JSON logging is EPIC 17. This knob is the level only.
LOG_LEVEL=debug
