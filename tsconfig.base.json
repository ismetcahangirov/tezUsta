// Repo-root alias for the shared preset. The options themselves live in
// packages/typescript-config/base.json so that every workspace and every
// bundler resolves the same file. Referenced by turbo.json globalDependencies.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "TezUsta base (root alias)",
  "extends": "./packages/typescript-config/base.json",
  "exclude": ["node_modules", "dist", "build", ".turbo", "coverage"]
}
