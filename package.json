{
  "name": "tezusta",
  "version": "0.0.0",
  "private": true,
  "description": "TezUsta — on-demand local home-service marketplace",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "eslint . && turbo run lint",
    "typecheck": "tsc --noEmit -p tsconfig.json && turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}\"",
    "graph": "node tools/project-graph/generate.mjs",
    "graph:validate": "node tools/project-graph/validate.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm graph:validate",
    "graph:check": "node tools/project-graph/generate.mjs && git diff --exit-code --stat tools/project-graph/output"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.4",
    "dependency-cruiser": "18.3.0",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
