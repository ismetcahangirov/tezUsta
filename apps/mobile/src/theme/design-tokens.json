{
  "$schema": "./tokens.schema.json",
  "$comment": "Single source of truth for the TezUsta design system. Consumed by src/theme/tokens.ts (typed runtime access) and by tailwind.config.js (NativeWind utilities). Derived from the design direction recorded in docs/design/design-system.md. Every colour pair here is contrast-checked by src/theme/contrast.test.ts — change a value and that test tells you whether it is still legible. In the type scale, `tracking` is letter-spacing in em, and `wide` is the size the admin panel and the web page grow a heading to on a wide screen (ADR-0070); the phone always uses `size`.",

  "color": {
    "light": {
      "bg": "#f0f2f5",
      "surface": "#ffffff",
      "surface-alt": "#e4e6eb",
      "text": "#111111",
      "text-muted": "#5c5c5c",
      "border": "#ced0d4",
      "accent": "#1877f2",
      "on-accent": "#ffffff",
      "inverse-surface": "#111111",
      "on-inverse": "#ffffff",
      "danger": "#c0272d",
      "on-danger": "#ffffff",
      "track": "#111111",
      "focus": "#111111",
      "overlay": "#111111"
    },
    "dark": {
      "bg": "#111111",
      "surface": "#1f1f1f",
      "surface-alt": "#2e2e2e",
      "text": "#ffffff",
      "text-muted": "#a1a1a1",
      "border": "#3a3a3a",
      "accent": "#1877f2",
      "on-accent": "#ffffff",
      "inverse-surface": "#ffffff",
      "on-inverse": "#111111",
      "danger": "#ff6b6b",
      "on-danger": "#111111",
      "track": "#ffffff",
      "focus": "#ffffff",
      "overlay": "#000000"
    }
  },

  "space": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48
  },

  "radius": {
    "none": 0,
    "sm": 8,
    "md": 16,
    "lg": 28,
    "full": 999
  },

  "size": {
    "control-sm": 36,
    "control-md": 48,
    "control-lg": 56,
    "icon-button": 44,
    "touch-target": 44,
    "avatar-sm": 32,
    "avatar-md": 44,
    "avatar-lg": 64,
    "progress-height": 8,
    "hairline": 1
  },

  "typography": {
    "family": {
      "regular": "Inter-Regular",
      "medium": "Inter-Medium",
      "semibold": "Inter-SemiBold",
      "bold": "Inter-Bold",
      "italic": "Inter-Italic",
      "medium-italic": "Inter-MediumItalic",
      "semibold-italic": "Inter-SemiBoldItalic",
      "bold-italic": "Inter-BoldItalic"
    },
    "scale": {
      "display": {
        "size": 36,
        "lineHeight": 40,
        "weight": "bold",
        "tracking": -0.025,
        "wide": { "size": 48, "lineHeight": 52 }
      },
      "h1": {
        "size": 28,
        "lineHeight": 34,
        "weight": "semibold",
        "tracking": -0.02,
        "wide": { "size": 32, "lineHeight": 38 }
      },
      "h2": {
        "size": 22,
        "lineHeight": 28,
        "weight": "semibold",
        "tracking": -0.015,
        "wide": { "size": 24, "lineHeight": 30 }
      },
      "lead": { "size": 18, "lineHeight": 28, "weight": "regular", "tracking": 0 },
      "body": { "size": 16, "lineHeight": 24, "weight": "regular", "tracking": 0 },
      "body-strong": { "size": 16, "lineHeight": 24, "weight": "semibold", "tracking": 0 },
      "caption": { "size": 14, "lineHeight": 20, "weight": "regular", "tracking": 0 },
      "footnote": { "size": 12, "lineHeight": 16, "weight": "regular", "tracking": 0 }
    }
  },

  "icon": {
    "stroke": 1.75,
    "size": { "sm": 16, "md": 20, "lg": 24 }
  }
}
