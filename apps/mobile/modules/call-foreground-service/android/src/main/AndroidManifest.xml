<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- A voice call keeps its microphone and its network while the app is in
       the background only from a foreground service (#183). Android 14+
       requires the typed permission as well as the type on the service. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

  <application>
    <service
      android:name="az.tezusta.callforegroundservice.CallForegroundService"
      android:exported="false"
      android:foregroundServiceType="microphone" />
  </application>
</manifest>
