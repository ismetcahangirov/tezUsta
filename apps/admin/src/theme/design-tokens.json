  "$comment": "The ADR-0011 design tokens, as the admin panel consumes them. Every value is copied from apps/mobile/src/theme/design-tokens.json, and src/theme/design-tokens.test.ts fails the build if the two drift. The copy exists because an app may not import another app; it becomes one shared file when the tokens move to a package (ADR-0016). Only the typeface differs: the web has one variable family where React Native has one family per weight and slant.",

  "color": {
    "light": {
      "bg": "#f0f2f5",
      "surface": "#ffffff",
      "surface-alt": "#e4e6eb",
      "text": "#111111",
      "text-muted": "#5c5c5c",
      "border": "#ced0d4",
      "accent": "#1877f2",
      "on-accent": "#ffffff",
      "inverse-surface": "#111111",
      "on-inverse": "#ffffff",
      "danger": "#c0272d",
      "on-danger": "#ffffff",
      "track": "#111111",
      "focus": "#111111",
      "overlay": "#111111"
    },
    "dark": {
      "bg": "#111111",
      "surface": "#1f1f1f",
      "surface-alt": "#2e2e2e",
      "text": "#ffffff",
      "text-muted": "#a1a1a1",
      "border": "#3a3a3a",
      "accent": "#1877f2",
      "on-accent": "#ffffff",
      "inverse-surface": "#ffffff",
      "on-inverse": "#111111",
      "danger": "#ff6b6b",
      "on-danger": "#111111",
      "track": "#ffffff",
      "focus": "#ffffff",
      "overlay": "#000000"
    }
  },

