# The master's web subscription page and the API on one origin (ADR-0061 § 1),
# served exactly as the admin panel is (ADR-0052), on an origin of its own.
#
# `/api/*` goes to the API with the prefix stripped — exactly what the Vite
# dev server does — so the page is one build in every environment. Every
# other path is the page: a file if one exists, `index.html` if not, so the
# provider's return to `/return` loads the app.
#
# Rendered at start by the image's entrypoint: `${API_UPSTREAM}` is the one
# variable substituted (`envsubst` only touches variables that are set), and
# nginx's own `$uri`, `$host` and friends are left alone.

# A WebSocket upgrade passes through; a plain request keeps the connection.
map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

server {
  listen 8080;
  server_name _;
  server_tokens off;

  root /usr/share/nginx/html;

  gzip on;
  gzip_vary on;
  gzip_types text/css application/javascript application/json image/svg+xml;
  gzip_min_length 1024;

  # The API. Its own security headers come with its responses (#275); nothing
  # here overrides them.
  location /api/ {
    proxy_pass ${API_UPSTREAM}/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # Appended, never replaced: the API trusts only this proxy's address
    # (`TRUST_PROXY`) and takes the right-most address before it, which a
    # client cannot forge by sending its own header.
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Now that this hop is trusted, Fastify would believe a client-sent host
    # header too. Nothing reads it today; it is cleared so nothing can start to.
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header Forwarded "";
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    # Above the API's own 1 MiB limit, so an oversized body gets the API's
    # JSON 413 rather than an nginx HTML page.
    client_max_body_size 2m;
  }

  # `/api` itself is the API's root, never the page.
  location = /api {
    rewrite ^ /api/ last;
  }

  # Vite's content-hashed build output: a changed file is a new name, so a
  # year is safe and a revalidation is a wasted round trip.
  #
  # Not `always`: a 404 for a hashed name — a browser holding a new
  # `index.html` asking an old replica mid-deploy — must not be cached for a
  # year, or that browser keeps a broken page until the next release.
  location /assets/ {
    include /etc/nginx/tezusta/page-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # The page: `index.html` and the few unhashed files beside it (favicons,
  # the wordmark) are revalidated on every load, so a release reaches an open
  # browser on its next navigation.
  location / {
    include /etc/nginx/tezusta/page-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri /index.html;
  }
}
