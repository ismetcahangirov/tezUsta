# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
.turbo/
*.tsbuildinfo

# Environment — NEVER commit real secrets (see docs/engineering/security.md)
.env
.env.*
!.env.example
!.env.*.example

