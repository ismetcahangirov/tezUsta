!.vscode/extensions.json
!.vscode/settings.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Claude local overrides
.claude/settings.local.json

# Agent worktrees. Claude Code creates a git worktree per isolated subagent
# under this path; each is a full checkout of this repository, so without this
# line a `git add -A` in the main worktree stages somebody else's whole tree.
.claude/worktrees/

# The same hazard from a different agent tool. Kilo Code puts its worktrees
# here, and a checkout of this repository nested inside this repository is a
# second copy of every workspace: `git add -A` stages it, and `pnpm lint` walks
# into it and dies resolving `@tezusta/eslint-config` against the nested
# `node_modules` that does not exist there. Both are ignored, in .gitignore and
# in eslint.config.mjs respectively.
.kilo/
