# Normalise line endings to LF in the repository.
#
# Without this, a Windows checkout with core.autocrlf=true writes CRLF to the
# working tree, which then fails `prettier --check` (endOfLine: "lf") and
# produces whole-file diffs between contributors on different platforms.
* text=auto eol=lf

# Binary files — never touch these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.keystore binary
*.jks   binary
*.p12   binary
*.p8    binary

# Generated — collapse in diffs and exclude from language statistics.
pnpm-lock.yaml                        linguist-generated=true -diff
tools/project-graph/output/*.json     linguist-generated=true -diff
tools/project-graph/output/GRAPH.md   linguist-generated=true
